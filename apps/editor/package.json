    "@angular/router": "22.2.1",
    "@coschema/geometry": "workspace:*",
    "@coschema/model": "workspace:*",
    "@coschema/sync": "workspace:*",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "y-indexeddb": "9.0.12",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@vitest/coverage-v8": "5.0.3",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.1",
    "vitest": "5.0.3",
    "y-protocols": "1.0.7"
